NODE_ENV=production
PORT=3001

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.supabase.co:5432/postgres?schema=public&connection_limit=20&pool_timeout=5

REDIS_URL=redis://:YOUR_PASSWORD@redis.upstash.io:6379
REDIS_HOST=redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

ACCESS_TOKEN_SECRET=YOUR_ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=YOUR_REFRESH_TOKEN_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Cv Builder Ai <noreply@cvbuilderai.com>"

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://api.moncvpro.com/api/v1/auth/google/callback

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_CALLBACK_URL=https://api.moncvpro.com/api/v1/auth/linkedin/callback

STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

SENTRY_DSN=https://your-dsn@sentry.io/project-id
LOG_LEVEL=info

FRONTEND_URL=https://moncvpro.com
NEXT_PUBLIC_API_URL=https://api.moncvpro.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.moncvpro.com
NEXT_PUBLIC_CDN_URL=https://cdn.moncvpro.com

NEXT_PUBLIC_GA_ID=YOUR_GA_ID
NEXT_PUBLIC_MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=900
ALERT_ENABLED=true
ALLOWED_ORIGINS=https://moncvpro.com,https://www.moncvpro.com
