# ==============================================
# MonCVPro Backend - Environment Variables
# ==============================================

# Database Configuration
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/moncvpro_dev

# Security - JWT Tokens
# CRITICAL: Change these to random 32+ character secrets in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-random-32-char-secret-in-production
REFRESH_TOKEN_SECRET=change-me-to-random-32-char-secret-in-production

# Frontend URL (for CORS whitelist)
# Multiple origins can be comma-separated
# Development:
FRONTEND_URL=http://localhost:3000
# Production example:
# FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# Server Configuration
NODE_ENV=development
PORT=5000

# OpenAI API (optional - for AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Supabase (optional - if using Supabase for storage/auth)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# ==============================================
# SECURITY NOTES:
# - Never commit .env files to version control
# - Use strong, unique secrets for production
# - Keep DATABASE_URL and JWT secrets private
# - Regularly rotate JWT secrets in production
# ==============================================
