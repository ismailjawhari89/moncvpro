# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/moncvpro

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_long

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_LOGIN_ATTEMPTS=5
AUTH_REGISTER_ATTEMPTS=3
UPLOAD_REQUESTS_LIMIT=10
AI_GENERATE_REQUESTS_LIMIT=20

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://moncvpro.pages.dev

# Security
REQUEST_SIZE_LIMIT=1mb

# OpenAI Configuration (if needed)
OPENAI_API_KEY=your_openai_api_key_here

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
