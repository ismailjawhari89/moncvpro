{
    "name": "moncvpro-backend",
    "version": "1.0.0",
    "description": "MonCVPro Backend API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "build": "npx prisma generate && tsc",
        "postinstall": "npx prisma generate",
        "start": "node dist/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts",
        "prisma:generate": "npx prisma generate",
        "prisma:migrate": "npx prisma migrate deploy",
        "prisma:studio": "npx prisma studio",
        "docker:build": "docker build -t moncvpro-backend .",
        "docker:run": "docker run -p 3001:3001 moncvpro-backend",
        "worker:pdf": "ts-node src/workers/pdf.worker.ts",
        "worker:ai": "ts-node src/workers/ai.worker.ts",
        "worker:email": "ts-node src/workers/email.worker.ts"
    },
    "keywords": [
        "resume",
        "cv",
        "ai",
        "saas"
    ],
    "author": "MonCVPro Team",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
