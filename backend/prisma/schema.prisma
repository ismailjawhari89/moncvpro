generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  password      String? // bcrypt hashed, optional for OAuth users
  firstName     String?
  lastName      String?
  profileImage  String?
  emailVerified DateTime? // Auto-verified for OAuth
  
  // Admin fields
  role          AdminRole?
  isAdmin       Boolean   @default(false)
  adminNotes    String?
  suspendedAt   DateTime?
  suspensionReason String?
  adminActions  AdminAuditLog[] @relation("AdminActions")

  // Brute force protection
  isLocked      Boolean   @default(false)
  lockUntil     DateTime?

  // Relations
  cvs            CV[]
  auditLogs      AuditLog[]
  linkedIn       LinkedInAccount?
  google         GoogleAccount?
  jobMatches     JobMatch[]
  comments       CVComment[]
  sessions       Session[]
  passwordResets PasswordReset[]
  refreshTokens  RefreshToken[]
  twoFactor      TwoFactorAuth?
  loginAttempts  LoginAttempt[]
  passwordHistory PasswordHistory[]
  verificationTokens VerificationToken[]
  
  // Email system
  emailPreferences EmailPreference?
  emailEvents      EmailEvent[]
  consentLogs      ConsentLog[]

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([email])
  @@index([createdAt])
  @@index([isAdmin])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Device info
  deviceName      String?   // "Chrome on Windows", etc.
  userAgent       String?
  ipAddress       String?
  
  // Tokens (tracking active access)
  accessToken     String
  
  // Activity
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  
  @@index([userId])
  @@index([accessToken])
  @@index([expiresAt])
}

model LoginAttempt {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String?
  ipAddress       String
  
  success         Boolean
  createdAt       DateTime  @default(now())
  
  @@index([email])
  @@index([ipAddress])
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password  String   // Hashed
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique // hashed
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TwoFactorAuth {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method               String // "totp", "email", "sms"
  isEnabled            Boolean  @default(false)
  totpSecret           String? // Encrypted
  phoneNumber          String?
  backupCodes          String[] // Encrypted
  lastVerifiedAt       DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Keep original Session logic if needed or fully replace with new one.
// The user explicitly asked for the new Session model above.
// Removing the old Session model.

model VerificationToken {
  id     String    @id @default(cuid())
  userId String?   // Optional: for password-reset, required for 2FA
  user   User?     @relation(fields: [userId], references: [id])
  email  String    // Always store email for verification
  token  String    @unique
  type   TokenType // "EMAIL_VERIFY", "PASSWORD_RESET", "TWO_FACTOR"

  // Lifecycle
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Metadata
  ipAddress String?
  userAgent String?

  @@index([email])
  @@index([token])
  @@index([type])
  @@index([userId])
  @@index([email, type])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  action    String   // "USER_SUSPENDED", "REFUND_ISSUED", etc.
  targetId  String?  // ID of the user or object affected
  changes   Json?    // Snapshot of changes or action details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model LinkedInAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedInId  String    @unique
  accessToken String?
  expiresAt   DateTime?
  updatedAt   DateTime  @updatedAt
}

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId     String    @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

model CV {
  id       String @id @default(cuid())
  title    String
  content  Json // Keep for legacy/flexibility
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  template String @default("modern-pro")

  // Granular data
  personalInfo Json?
  summary      String?
  experiences  Experience[]
  education    Education[]
  skills       Skill[]

  versions      CVVersion[]
  jobMatches    JobMatch[]
  atsScore      AtsScore?
  aiSuggestions AiSuggestion[]
  shares        CVShare[]
  comments      CVComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete

  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Experience {
  id          String  @id @default(cuid())
  cvId        String
  cv          CV      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  company     String
  position    String
  startDate   String
  endDate     String?
  current     Boolean @default(false)
  description String?
}

model Education {
  id             String  @id @default(cuid())
  cvId           String
  cv             CV      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  institution    String
  degree         String
  field          String?
  graduationYear String?
}

model Skill {
  id       String @id @default(cuid())
  cvId     String
  cv       CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  name     String
  level    Int    @default(3)
  category String @default("technical")
}

model JobMatch {
  id        String   @id @default(cuid())
  cvId      String
  cv        CV       @relation(fields: [cvId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  keywords  String
  source    String // 'linkedin', 'internal'
  matchedAt DateTime @default(now())
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String   // "LOGIN_SUCCESS", "PASSWORD_CHANGE", etc.
  actionDetails Json     // Changed from Object to Json for persistence
  ipAddress     String?
  userAgent     String?
  status        String   // "success", "failure"
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model CVVersion {
  id          String   @id @default(cuid())
  cvId        String
  cv          CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdBy   String
  createdAt   DateTime @default(now())
  description String?

  @@unique([cvId, version])
  @@index([cvId])
}

model CVTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String
  data      Json
  downloads Int      @default(0)
  rating    Float    @default(4.5)
  createdAt DateTime @default(now())
}

model AtsScore {
  id              String   @id @default(cuid())
  cvId            String   @unique
  cv              CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  score           Int
  breakdown       Json // Breakdown by category
  improvements    Json // Array of improvement items
  matchPercentage Int? // With specific job description
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiSuggestion {
  id             String   @id @default(cuid())
  cvId           String
  cv             CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  section        String // 'experiences', 'skills', 'summary'
  suggestions    Json // Array of suggestions
  jobDescription String?
  createdAt      DateTime @default(now())
}

model CVShare {
  id         String          @id @default(cuid())
  cvId       String
  cv         CV              @relation(fields: [cvId], references: [id], onDelete: Cascade)
  sharedWith String // userId or email
  permission SharePermission // 'view', 'comment', 'edit'
  expiresAt  DateTime?
  token      String          @unique // Anonymous link token
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([cvId, sharedWith])
}

enum SharePermission {
  view
  comment
  edit
}

model CVComment {
  id        String   @id @default(cuid())
  cvId      String
  cv        CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  section   String // 'experiences', 'skills', etc
  sectionId String? // ID of specific item
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cvId])
  @@index([userId])
}

model EmailPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  
  securityAlerts  Boolean  @default(true)
  productUpdates  Boolean  @default(true)
  onboardingEmails Boolean @default(true)
  newsletters     Boolean  @default(true)
  
  updatedAt       DateTime @updatedAt
}

model EmailEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  templateId String
  eventType String // "sent", "delivered", "opened", "clicked", "bounced"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([templateId, createdAt])
}

model ConsentLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // analytics, marketing
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
}
