// Prisma Schema for CV Master AI
// Complete database schema covering all aspects of the project

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String
  firstName     String?
  lastName      String?
  profileImage  String?
  bio           String?
  phoneNumber   String?

  // Relations
  cvs          CV[]
  subscription Subscription?
  usageMetrics UsageMetric?
  settings     UserSettings?
  sessions     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// CV MANAGEMENT
// ============================================

model CV {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])

  // Content - Stored as JSON for flexibility
  personalInfo   Json // { firstName, lastName, email, phone, location, summary }
  experience     Json // Array of work experiences
  education      Json // Array of education entries
  skills         Json // { technical: [], soft: [] }
  languages      Json // Array of languages with proficiency levels
  customSections Json? // Optional custom sections (certifications, projects, etc.)

  // Status Management
  status    String  @default("draft") // draft, published, archived
  isPublic  Boolean @default(false)
  publicUrl String? @unique

  // Version Control
  versionNumber   Int     @default(1)
  parentVersionId String? // Reference to parent version for history tracking
  versions        CV[]    @relation("CVVersions")
  originalVersion CV?     @relation("CVVersions", fields: [parentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // AI-Powered Features
  atsScore      Float? // ATS score from 0-100
  atsAnalysis   Json? // Detailed ATS analysis results
  lastAIEnhance DateTime? // Last time AI enhancement was applied

  // Export Tracking
  exports Export[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([parentVersionId])
}

// ============================================
// TEMPLATE MANAGEMENT
// ============================================

model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String // modern, classic, elegant, creative, professional
  thumbnail   String? // URL to template thumbnail image
  preview     String? // URL to template preview

  // Design Configuration
  colors Json // { primary, secondary, accent, text, background }
  fonts  Json // { heading, body, sizes }
  layout String // 1col, 2col, 3col
  config Json? // Additional custom template configuration

  // Usage and Access Control
  cvs       CV[]
  isPublic  Boolean @default(true)
  isPremium Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPremium])
}

// ============================================
// SUBSCRIPTION & BILLING
// ============================================

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String // free, pro, premium
  status String // active, canceled, expired, trialing

  // Billing Period
  priceId            String? // Stripe Price ID
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Payment Integration (Stripe)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Plan Limits
  cvLimit       Int // Maximum CVs allowed
  templateLimit Int // Maximum custom templates
  exportLimit   Int // Monthly export limit
  aiUsageLimit  Int // Monthly AI feature usage limit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

// ============================================
// USAGE METRICS & ANALYTICS
// ============================================

model UsageMetric {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Monthly Usage Tracking (resets monthly)
  currentMonth       String // YYYY-MM format
  exportsThisMonth   Int    @default(0)
  aiUsesThisMonth    Int    @default(0)
  cvCreatedThisMonth Int    @default(0)

  // Lifetime Totals
  totalCVsCreated Int @default(0)
  totalExports    Int @default(0)
  totalAIUses     Int @default(0)

  // Engagement Metrics
  lastActivityAt DateTime?
  lastExportAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentMonth])
  @@index([lastActivityAt])
}

// ============================================
// EXPORT MANAGEMENT
// ============================================

model Export {
  id   String @id @default(cuid())
  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  format   String // pdf, docx, png, json
  fileName String
  fileUrl  String? // URL to stored export file
  fileSize Int? // File size in bytes

  status       String  @default("pending") // pending, completed, failed
  errorMessage String? // Error details if export failed

  createdAt DateTime @default(now())

  @@index([cvId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// USER SETTINGS & PREFERENCES
// ============================================

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Language & Display Preferences
  language String  @default("en") // ar, fr, en
  theme    String  @default("light") // light, dark, system
  timezone String?

  // Notification Preferences
  emailNotifications Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  newFeatures        Boolean @default(true)

  // Privacy Settings
  profilePublic  Boolean @default(false)
  allowAnalytics Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ============================================
// AUTHENTICATION & SESSION MANAGEMENT
// ============================================

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token        String  @unique
  refreshToken String? @unique

  // Session Metadata
  userAgent String?
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================
// PAYMENT TRACKING
// ============================================

model Payment {
  id              String @id @default(cuid())
  stripePaymentId String @unique

  amount   Int // Amount in cents
  currency String @default("usd")
  status   String // succeeded, failed, pending, refunded

  userId         String?
  subscriptionId String?

  metadata     Json? // Additional payment metadata
  errorMessage String? // Error details if payment failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// AUDIT & SECURITY LOGGING
// ============================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action       String // create, update, delete, login, logout, export, ai_enhance
  resourceType String // cv, user, settings, template, subscription
  resourceId   String?

  changes   Json? // JSON object describing what changed
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}
