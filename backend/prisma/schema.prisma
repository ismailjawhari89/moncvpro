datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// User Management
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String?
  lastName      String?
  phoneNumber   String?
  profileImage  String?
  
  // Account status
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  
  // Security
  lastLoginAt   DateTime?
  lastLoginIp   String?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  passwordChangedAt DateTime?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  
  // Relations
  resumes       Resume[]
  sessions      Session[]
  uploads       Upload[]
  apiKeys       ApiKey[]
  activityLogs  ActivityLog[]
  
  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  refreshToken String? @unique
  ipAddress   String
  userAgent   String?
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  revokedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// Resume/CV Management
// ============================================================================

model Resume {
  id            String   @id @default(cuid())
  userId        String
  
  // Basic Info
  title         String
  slug          String   @unique
  description   String?
  templateId    String   @default("modern")
  
  // Content (stored as JSON)
  personalInfo  Json?
  summary       String?  @db.Text
  content       Json     @db.JsonB
  
  // Metadata
  isPublic      Boolean  @default(false)
  isTemplate    Boolean  @default(false)
  language      String   @default("en")
  
  // Status
  status        ResumeStatus @default(DRAFT)
  publishedAt   DateTime?
  
  // Analytics
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  shareCount    Int      @default(0)
  
  // AI Features
  atsScore      Float?
  lastAnalyzedAt DateTime?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      ResumeVersion[]
  exports       Export[]
  shares        Share[]
  aiGenerations AiGeneration[]
  
  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([isPublic])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("resumes")
}

enum ResumeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ResumeVersion {
  id          String   @id @default(cuid())
  resumeId    String
  versionNumber Int
  content     Json     @db.JsonB
  changeDescription String?
  
  createdAt   DateTime @default(now())
  createdBy   String?
  
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  @@unique([resumeId, versionNumber])
  @@index([resumeId])
  @@index([createdAt])
  @@map("resume_versions")
}

// ============================================================================
// Export Management
// ============================================================================

model Export {
  id          String   @id @default(cuid())
  resumeId    String
  
  format      ExportFormat
  filename    String
  fileUrl     String?
  fileSize    Int?
  
  status      ExportStatus @default(PENDING)
  errorMessage String?
  
  createdAt   DateTime @default(now())
  completedAt DateTime?
  
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  @@index([resumeId])
  @@index([status])
  @@index([createdAt])
  @@map("exports")
}

enum ExportFormat {
  PDF
  DOCX
  PNG
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================================
// Sharing & Collaboration
// ============================================================================

model Share {
  id          String   @id @default(cuid())
  resumeId    String
  
  shareToken  String   @unique
  password    String?
  
  expiresAt   DateTime?
  maxViews    Int?
  viewCount   Int      @default(0)
  
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  lastViewedAt DateTime?
  
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  @@index([resumeId])
  @@index([shareToken])
  @@index([isActive])
  @@map("shares")
}

// ============================================================================
// AI Features
// ============================================================================

model AiGeneration {
  id          String   @id @default(cuid())
  resumeId    String?
  userId      String?
  
  type        AiGenerationType
  prompt      String   @db.Text
  input       Json?    @db.JsonB
  output      Json?    @db.JsonB
  
  model       String   @default("gpt-3.5-turbo")
  tokens      Int?
  cost        Float?
  
  status      AiGenerationStatus @default(PENDING)
  errorMessage String?
  
  createdAt   DateTime @default(now())
  completedAt DateTime?
  
  resume      Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  
  @@index([resumeId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("ai_generations")
}

enum AiGenerationType {
  SUMMARY
  BULLET_POINTS
  COVER_LETTER
  SKILL_SUGGESTIONS
  JOB_MATCH
  ATS_ANALYSIS
  REWRITE
  TRANSLATE
}

enum AiGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AiCache {
  id          String   @id @default(cuid())
  
  cacheKey    String   @unique
  type        AiGenerationType
  input       Json     @db.JsonB
  output      Json     @db.JsonB
  
  hitCount    Int      @default(0)
  
  createdAt   DateTime @default(now())
  lastHitAt   DateTime @default(now())
  expiresAt   DateTime
  
  @@index([cacheKey])
  @@index([type])
  @@index([expiresAt])
  @@map("ai_cache")
}

// ============================================================================
// File Management
// ============================================================================

model Upload {
  id          String   @id @default(cuid())
  userId      String
  
  filename    String
  originalName String
  mimeType    String
  fileSize    Int
  filePath    String
  
  uploadType  UploadType
  metadata    Json?    @db.JsonB
  
  isPublic    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([uploadType])
  @@index([createdAt])
  @@map("uploads")
}

enum UploadType {
  PROFILE_IMAGE
  RESUME_PDF
  COVER_LETTER
  PORTFOLIO
  OTHER
}

// ============================================================================
// Templates
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  
  name        String
  slug        String   @unique
  description String?
  category    String
  
  thumbnail   String?
  previewUrl  String?
  
  config      Json     @db.JsonB
  styles      Json?    @db.JsonB
  
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  
  usageCount  Int      @default(0)
  rating      Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([isPremium])
  @@index([isActive])
  @@map("templates")
}

// ============================================================================
// API & Integration
// ============================================================================

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  
  name        String
  key         String   @unique
  
  permissions Json?    @db.JsonB
  
  lastUsedAt  DateTime?
  lastUsedIp  String?
  usageCount  Int      @default(0)
  
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

// ============================================================================
// Analytics & Logging
// ============================================================================

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  
  action      String
  entity      String?
  entityId    String?
  
  ipAddress   String?
  userAgent   String?
  
  metadata    Json?    @db.JsonB
  
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("activity_logs")
}

model Analytics {
  id          String   @id @default(cuid())
  
  date        DateTime @db.Date
  metric      String
  value       Float
  
  dimensions  Json?    @db.JsonB
  
  createdAt   DateTime @default(now())
  
  @@unique([date, metric])
  @@index([date])
  @@index([metric])
  @@map("analytics")
}

// ============================================================================
// System & Configuration
// ============================================================================

model RateLimitLog {
  id          String   @id @default(cuid())
  
  ipAddress   String
  endpoint    String
  route       String
  
  attempts    Int      @default(1)
  blocked     Boolean  @default(false)
  
  timestamp   DateTime @default(now())
  resetAt     DateTime
  
  metadata    Json?    @db.JsonB
  
  @@index([ipAddress])
  @@index([endpoint])
  @@index([timestamp])
  @@index([blocked])
  @@map("rate_limit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  
  key         String   @unique
  value       Json     @db.JsonB
  description String?
  
  isPublic    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@map("system_config")
}

// ============================================================================
// Notifications
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  
  type        NotificationType
  title       String
  message     String   @db.Text
  
  data        Json?    @db.JsonB
  
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  EXPORT_COMPLETE
  SHARE_VIEWED
  AI_COMPLETE
  SECURITY_ALERT
}
