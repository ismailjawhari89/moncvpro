# Ignore node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.local
.env.production
.env.test
.env.*.local
*.secrets
secrets/
backend/.env
backend/.env.*

# Ignore build outputs
dist/
build/
.next/
out/

# Ignore logs
logs/
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore test coverage
coverage/
.nyc_output/

# Ignore temporary files
tmp/
temp/
*.tmp

# Ignore database files
*.db
*.sqlite
*.sqlite3

# Ignore Docker volumes
postgres_data/
redis_data/

# Ignore sensitive files
*.pem
*.key
*.cert

# Ignore backup files
*.backup
*.bak

# Ignore generated files
prisma/migrations/*_migration.sql
.prisma/

# Keep important files
! .env.example
! .env.example.*
! .env.template
!backend/.env.example
!frontend/.env.example
!.env.production.template
!.github/
!.docs/
!docs/
