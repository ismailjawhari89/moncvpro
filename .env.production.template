# Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values

# ============================================
# BACKEND CONFIGURATION
# ============================================

NODE_ENV=production
PORT=3001

# ============================================
# DATABASE
# ============================================

DATABASE_URL=YOUR_DATABASE_URL

# ============================================
# REDIS
# ============================================

REDIS_URL=YOUR_REDIS_URL
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD


# ============================================
# SECURITY & AUTHENTICATION
# ============================================

ACCESS_TOKEN_SECRET=YOUR_ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=YOUR_REFRESH_TOKEN_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# EMAIL CONFIGURATION
# ============================================

# SMTP Settings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_EMAIL_USER
SMTP_PASS=YOUR_EMAIL_PASSWORD
EMAIL_FROM="Cv Builder Ai <noreply@cvbuilderai.com>" 

# ============================================
# OAUTH PROVIDERS
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://api.moncvpro.com/api/v1/auth/google/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_CALLBACK_URL=https://api.moncvpro.com/api/v1/auth/linkedin/callback

# ============================================
# PAYMENT PROCESSING
# ============================================

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ============================================
# AI SERVICES
# ============================================

GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ============================================
# MONITORING & LOGGING
# ============================================

SENTRY_DSN=YOUR_SENTRY_DSN
LOG_LEVEL=info

# ============================================
# FRONTEND CONFIGURATION
# ============================================

FRONTEND_URL=https://moncvpro.com
NEXT_PUBLIC_API_URL=https://api.moncvpro.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.moncvpro.com
NEXT_PUBLIC_CDN_URL=https://cdn.moncvpro.com

# ============================================
# ANALYTICS
# ============================================

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ============================================
# AWS (for backups and file storage)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ============================================
# SECURITY
# ============================================

BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=900
ALERT_ENABLED=true
ALLOWED_ORIGINS=https://moncvpro.com,https://www.moncvpro.com
