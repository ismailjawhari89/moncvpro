# MonCVPro - Production Environment Variables Example

# --- FRONTEND (Next.js) ---
# Location: frontend/.env.local

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Worker URL
NEXT_PUBLIC_WORKER_URL=https://moncvpro-worker.your-username.workers.dev

# Express Backend (Optional, if not using Next.js API routes)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Replicate API (for AI Photo Editor)
REPLICATE_API_TOKEN=your-replicate-token


# --- BACKEND WORKER (Cloudflare Worker) ---
# Location: wrangler.toml [vars] or Cloudflare Dashboard

GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
OPENAI_API_KEY=your-openai-key


# --- BACKEND (Express - Optional) ---
# Location: backend/.env

PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-secure-secret
OPENAI_API_KEY=your-openai-key
